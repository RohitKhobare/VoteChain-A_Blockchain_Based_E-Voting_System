{
  "name": "votechain",
  "version": "1.0.0",
  "description": "VoteChain: A Blockchain-Based E-Voting System (Hardhat + Solidity + React + Ethers.js + MetaMask)",
  "private": true,
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "node": "hardhat node",
